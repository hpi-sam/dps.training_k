{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "prod": "npm run build-only && npx serve -s dist -l 5173",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build --mode prod",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "socket.io-client": "^4.7.4",
    "vue": "^3.3.11",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.7.2",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.11.10",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "cypress": "^15.12.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "npm-run-all2": "^6.1.1",
    "serve": "^14.2.3",
    "typescript": "~5.8.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.2.5"
  }
}
